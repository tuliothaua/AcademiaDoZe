<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage"
             x:Name="RootPage"
             Title="Logradouros"
             BackgroundColor="#F4F7FB">
    <Grid Padding="22" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="CADASTROS" FontSize="13" FontAttributes="Bold" TextColor="#149A98" />
            <Label Text="Logradouros" FontSize="29" FontAttributes="Bold" TextColor="#173653" />
            <Label Text="Consulte, pesquise e mantenha os endereços da academia." FontSize="14" TextColor="#667085" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Text="{Binding SearchText}" Placeholder="Buscar por rua, bairro, cidade ou CEP"
                   ReturnType="Search" ReturnCommand="{Binding SearchCommand}" ClearButtonVisibility="WhileEditing"
                   BackgroundColor="White" TextColor="#173653" PlaceholderColor="#667085" />
            <Button Grid.Column="1" Text="Buscar" Command="{Binding SearchCommand}"
                    BackgroundColor="#173653" TextColor="White" CornerRadius="12" />
            <Button Grid.Column="2" Text="+ Novo" Command="{Binding AddCommand}"
                    BackgroundColor="#149A98" TextColor="White" CornerRadius="12" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Logradouros}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Nenhum Logradouro encontrado" FontSize="18" FontAttributes="Bold" TextColor="#173653" HorizontalTextAlignment="Center" />
                    <Label Text="Cadastre um endereço ou altere o termo da busca." FontSize="14" TextColor="#667085" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="16" BackgroundColor="White" Stroke="#E5EAF0" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="5">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nome}" FontSize="17" FontAttributes="Bold" TextColor="#173653" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Bairro}" FontSize="14" TextColor="#344054" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{Binding Cidade}" FontSize="13" TextColor="#667085" />
                            <Label Grid.Row="3" Grid.Column="0" Text="{Binding Estado}" FontSize="13" TextColor="#667085" />
                            <Label Grid.Row="4" Grid.Column="0" Text="{Binding Cep}" FontSize="13" TextColor="#667085" />
                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                <Button Text="Editar" Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.EditCommand}"
                                        CommandParameter="{Binding .}" BackgroundColor="#EAF4F4" TextColor="#173653" CornerRadius="10" />
                                <Button Text="Excluir" Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding .}" BackgroundColor="#FFF0EF" TextColor="#A7352A" CornerRadius="10" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
