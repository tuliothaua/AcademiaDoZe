<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroFormPage"
             Title="Logradouro"
             BackgroundColor="{AppThemeBinding Light=#F4F7FB, Dark=#101923}">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="14">
            <VerticalStackLayout Spacing="4">
                <Label Text="ENDEREÇO" FontSize="13" FontAttributes="Bold" TextColor="#149A98" />
                <Label Text="{Binding Title}" FontSize="29" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}" />
                <Label Text="Preencha os dados do endereço. Os campos são validados antes de salvar."
                       FontSize="14" TextColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" />
            </VerticalStackLayout>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#182534}"
                    Stroke="{AppThemeBinding Light=#E5EAF0, Dark=#29394B}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="CEP" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#344054, Dark=#D0D8E2}" />
                    <Entry Text="{Binding Cep}" Placeholder="Ex.: 88000000" Keyboard="Numeric" MaxLength="9"
                           TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}"
                           PlaceholderColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" />
                    <Label Text="Nome do Logradouro" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#344054, Dark=#D0D8E2}" />
                    <Entry Text="{Binding Nome}" Placeholder="Ex.: Rua Túlio Thauã Dutra"
                           TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}"
                           PlaceholderColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" />
                    <Label Text="Bairro" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#344054, Dark=#D0D8E2}" />
                    <Entry Text="{Binding Bairro}" Placeholder="Informe o bairro"
                           TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}"
                           PlaceholderColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" />
                    <Label Text="Cidade" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#344054, Dark=#D0D8E2}" />
                    <Entry Text="{Binding Cidade}" Placeholder="Informe a cidade"
                           TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}"
                           PlaceholderColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Estado (UF)" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#344054, Dark=#D0D8E2}" />
                            <Entry Text="{Binding Estado}" Placeholder="SC" MaxLength="2" CharacterCasing="Upper"
                                   TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}"
                                   PlaceholderColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="País" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#344054, Dark=#D0D8E2}" />
                            <Entry Text="{Binding Pais}" Placeholder="Brasil"
                                   TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}"
                                   PlaceholderColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Salvar Logradouro" ImageSource="database.png" Command="{Binding SaveCommand}"
                    BackgroundColor="#149A98" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark=White}" FontSize="16" FontAttributes="Bold"
                    CornerRadius="14" HeightRequest="54" />
            <Button Text="Cancelar" Command="{Binding CancelCommand}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#182534}"
                    TextColor="{AppThemeBinding Light=#173653, Dark=#F1F5F9}"
                    BorderColor="{AppThemeBinding Light=#D5DEE8, Dark=#34465A}" BorderWidth="1"
                    CornerRadius="14" HeightRequest="48" />
            <Label Text="Para a demonstração da atividade, cadastre um endereço com seu nome completo no campo Nome do Logradouro."
                   FontSize="12" TextColor="{AppThemeBinding Light=#667085, Dark=#A9B4C2}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
